[Unit]
Description=Despertar el touch de la pantalla (Goodix)
# El touch toma corriente de la pantalla. Al arrancar, el sistema lo busca antes de que la
# pantalla lo encienda, falla y no reintenta. Acá se lo vuelve a buscar ya con la pantalla prendida.
After=systemd-modules-load.service systemd-udev-settle.service
Before=betometro.service

[Service]
Type=oneshot
# Si tuvo que insistir o no apareció, queda en el registro del sistema con prioridad aviso («<4>»), que journald
# guarda en la tarjeta: antes demoraba hasta 15 s el arranque sin dejar rastro (11A-2.3)
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5; do if ls /sys/bus/i2c/drivers/Goodix-TS/ 2>/dev/null | grep -q 005d; then [ "$i" = 1 ] || echo "<4>despertar-touch: el touch apareció en el intento $i"; exit 0; fi; sleep 2; modprobe -r goodix_ts; sleep 1; modprobe goodix_ts; done; echo "<4>despertar-touch: el touch no apareció en 15 s (sin touch en la pantalla)"; exit 0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
