[Unit]
Description=Sonido de Betómetro (PulseAudio del sistema)
Before=betometro.service

[Service]
# notify: Betómetro arranca cuando el sonido ya está listo (antes podía encontrar el socket sin crear) (11B-1.4)
Type=notify
TimeoutStartSec=20
ExecStart=/usr/bin/pulseaudio --system --daemonize=no --disallow-exit --log-target=journal
# Salida por defecto: los auriculares (placa bcm2835), no el HDMI
# Auriculares como salida y volumen al 100 %, POR DETRÁS (--no-block en un servicio aparte): antes el arranque
# esperaba hasta 10 s este paso (medido en la Pi, 07/11/2026). Con la tele y la webcam ignoradas (regla de udev)
# los auriculares son la única salida, así que Betómetro ya suena bien aunque esto no haya terminado.
ExecStartPost=-/bin/systemctl start --no-block pulseaudio-auriculares.service
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
