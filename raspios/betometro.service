[Unit]
Description=Betómetro
After=systemd-user-sessions.service sound.target pulseaudio-sistema.service
Wants=pulseaudio-sistema.service
# Betómetro ocupa la pantalla: sin la consola de texto en tty1
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
Environment=LANG=C.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=XDG_RUNTIME_DIR=/run/betometro
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=BETO_RASPBERRY=1
Environment=BETO_DATOS=/var/lib/betometro
Environment=BETO_GPS=auto
Environment=BETO_VOZ=/usr/share/betometro/voz
RuntimeDirectory=betometro
StateDirectory=betometro
# La foto de arranque queda en pantalla hasta que Betómetro dibuja (sin parpadeo negro)
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/betometro --fisica
Restart=always
RestartSec=2
# Vigilante: Betómetro avisa «sigo vivo» cada 5 s; si se congela 30 s, se reinicia solo
WatchdogSec=30
NotifyAccess=main
# Prioridad: GPS, cronómetro y pulsador primero. El wifi (nice 10) y la cámara (nice 5) después
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
