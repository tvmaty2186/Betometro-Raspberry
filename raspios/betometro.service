[Unit]
Description=Betómetro
After=systemd-user-sessions.service sound.target pulseaudio-sistema.service
Wants=pulseaudio-sistema.service
# Betómetro ocupa la pantalla: sin la consola de texto en tty1
Conflicts=getty@tty1.service
After=getty@tty1.service
# Si se cae 4 veces en 5 minutos queda «fallado» y entra betometro-volver: si es una versión recién
# instalada, vuelve a la anterior y avisa; si no, espera y prueba de nuevo (auditoría 10-1.1 y 1.4).
# 10 minutos: si la versión nueva se TRABA al abrir (no se cae), cada intento dura 92 s y 4 intentos tienen que
# entrar en la ventana; con 5 minutos nunca entraban y no volvía atrás (auditoría 12)
StartLimitIntervalSec=600
StartLimitBurst=4
OnFailure=betometro-volver.service

[Service]
# notify: el vigilante empieza a contar cuando Betómetro avisa que abrió (READY=1), no al lanzarlo; con una
# base grande la Pi 3 puede tardar en abrir más que los 30 s del vigilante (10-1.4). Hoy abre en ~9 s.
Type=notify
TimeoutStartSec=90
Environment=LANG=C.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_HIDECURSOR=1
# Pantallas: la de 5" (DSI) es la principal y lleva el tacto; la tele (HDMI) a 1280×720 para el modo tele.
# Qt arma las pantallas solo al abrir: una tele enchufada después pide reiniciar Betómetro (docs/video.md)
Environment=QT_QPA_EGLFS_KMS_CONFIG=/usr/share/betometro/kms.json
Environment=XDG_RUNTIME_DIR=/run/betometro
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=BETO_RASPBERRY=1
Environment=BETO_DATOS=/var/lib/betometro
Environment=BETO_GPS=auto
Environment=BETO_VOZ=/usr/share/betometro/voz
# Video: decodificar con el procesador (los cuadros del chip no se pueden leer para dibujarlos; app/imagen_video.h)
Environment=QT_FFMPEG_DECODING_HW_DEVICE_TYPES=,
RuntimeDirectory=betometro
StateDirectory=betometro
# Más protegido sin dejar de ser root (auditoría 10-1.5 y 12): /usr, /boot y /etc de solo lectura, sin /home y con
# su propio /tmp. Betómetro escribe solo en /var/lib/betometro y /run/betometro (el pendrive se monta ahí). El
# instalador corre aparte (systemd-run), sin estas limitaciones.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
# La foto de arranque queda en pantalla hasta que Betómetro dibuja (sin parpadeo negro)
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/betometro --fisica
Restart=always
# Lo que Betómetro escribe (los errores de Qt van por ahí) queda en el registro: sin esto, journald lo
# guardaba como «info» y lo descartaba (MaxLevelStore=warning), y no se veía por qué se cerraba
SyslogLevel=warning
RestartSec=2
# Vigilante: Betómetro avisa «sigo vivo» cada 5 s; si se congela 30 s, se reinicia solo
WatchdogSec=30
NotifyAccess=main
# Prioridad: GPS, cronómetro y pulsador primero. El wifi (nice 10) y la cámara (nice 5) después
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
