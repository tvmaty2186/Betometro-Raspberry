# Sistema en squashfs, sin initramfs: tiene que estar adentro del kernel
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
# Vigilante del procesador
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
# Sin consola en el puerto serie (es del GPS)
CONFIG_SERIAL_AMBA_PL011_CONSOLE=n

# --- Kernel más chico (compila mucho más rápido): fuera lo que el Betómetro no usa ---
CONFIG_DEBUG_INFO_NONE=y
# Sistemas de archivos: solo squashfs, ext4 y vfat
CONFIG_BCACHEFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_NILFS2_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_NETWORK_FILESYSTEMS=n
# Discos en red, RAID y LVM
CONFIG_BLK_DEV_DRBD=n
CONFIG_BLK_DEV_RBD=n
CONFIG_BLK_DEV_NBD=n
CONFIG_MD=n
# Red: sin cortafuegos, puentes ni VPN (solo wifi y ethernet)
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_WIREGUARD=n
CONFIG_CAN=n
CONFIG_HAMRADIO=n
CONFIG_NFC=n
CONFIG_BT=n
# Wifi: solo el chip de la placa (Broadcom); fuera los wifi USB de otras marcas
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
# Cámaras, TV y radio: se vuelve a prender en E7 (video de la carrera)
CONFIG_MEDIA_SUPPORT=n
# Sensores y joysticks
CONFIG_IIO=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
