# Sistema en squashfs, sin initramfs: tiene que estar adentro del kernel
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
# Vigilante del procesador
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
# Sin consola en el puerto serie (es del GPS)
CONFIG_SERIAL_AMBA_PL011_CONSOLE=n

# --- Kernel más chico (compila mucho más rápido): fuera lo que el Betómetro no usa ---
CONFIG_DEBUG_INFO_NONE=y
# Sistemas de archivos: solo squashfs, ext4 y vfat
CONFIG_BCACHEFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_NILFS2_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_NETWORK_FILESYSTEMS=n
# Discos en red
CONFIG_BLK_DEV_DRBD=n
CONFIG_BLK_DEV_RBD=n
CONFIG_BLK_DEV_NBD=n
# Actualizaciones (RAUC): el paquete se verifica con dm-verity y se lee por un loop
CONFIG_BLK_DEV_LOOP=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_MD_RAID0=n
CONFIG_MD_RAID1=n
CONFIG_MD_RAID10=n
CONFIG_MD_RAID456=n
CONFIG_DM_CRYPT=n
CONFIG_DM_SNAPSHOT=n
CONFIG_DM_THIN_PROVISIONING=n
CONFIG_DM_CACHE=n
CONFIG_DM_MIRROR=n
CONFIG_DM_RAID=n
CONFIG_DM_MULTIPATH=n
# Red: sin cortafuegos, puentes ni VPN (solo wifi y ethernet)
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_WIREGUARD=n
CONFIG_CAN=n
CONFIG_HAMRADIO=n
CONFIG_NFC=n
CONFIG_BT=n
# Wifi: solo el chip de la placa (Broadcom); fuera los wifi USB de otras marcas
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
# Cámara (video de la carrera): webcams USB (UVC) y el chip de video de la placa
# (comprime y descomprime H.264). Sin TV, radio ni cámaras de otros tipos.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=n
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_MEDIA_SDR_SUPPORT=n
CONFIG_MEDIA_TEST_SUPPORT=n
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_GSPCA=n
CONFIG_VIDEO_BCM2835=n
CONFIG_VIDEO_CODEC_BCM2835=m
# Micrófono USB (o el de la cámara)
CONFIG_SND_USB_AUDIO=m
# Sensores y joysticks
CONFIG_IIO=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
